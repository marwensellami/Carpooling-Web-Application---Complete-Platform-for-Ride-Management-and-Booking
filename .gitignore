# ============================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
.fseventsd

# Linux
*~
.directory
.Trash-*
.nfs*

# ============================================
# 2. IDE / ÉDITEURS DE CODE
# ============================================

# Visual Studio Code
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/extensions.json.example

# JetBrains (PHPStorm, WebStorm, IntelliJ)
